{"openapi":"3.0.4","info":{"title":"Queue OpenAPI for fal-ai/depth-anything-video","version":"1.0.0","description":"The OpenAPI schema for the fal-ai/depth-anything-video queue.","x-fal-metadata":{"endpointId":"fal-ai/depth-anything-video","category":"video-to-video","thumbnailUrl":"https://v3b.fal.media/files/b/0a9098ac/VPiI1T3l10kKkmCWxcNSH_e3a99777f1b84afbaf4f7147a24a8221.jpg","playgroundUrl":"https://fal.ai/models/fal-ai/depth-anything-video","documentationUrl":"https://fal.ai/models/fal-ai/depth-anything-video/api","about":"Estimate depth from video and return visualization."}},"components":{"securitySchemes":{"apiKeyAuth":{"type":"apiKey","in":"header","name":"Authorization","description":"Fal Key"}},"schemas":{"QueueStatus":{"type":"object","properties":{"status":{"type":"string","enum":["IN_QUEUE","IN_PROGRESS","COMPLETED"]},"request_id":{"type":"string","description":"The request id."},"response_url":{"type":"string","description":"The response url."},"status_url":{"type":"string","description":"The status url."},"cancel_url":{"type":"string","description":"The cancel url."},"logs":{"type":"object","description":"The logs.","additionalProperties":true},"metrics":{"type":"object","description":"The metrics.","additionalProperties":true},"queue_position":{"type":"integer","description":"The queue position."}},"required":["status","request_id"]},"DepthAnythingVideoInput":{"title":"DepthAnythingVideoInput","type":"object","properties":{"include_raw_depths":{"title":"Include Raw Depths","type":"boolean","description":"Export raw float32 depths as .npz file with: 'depths' [N,H,W], 'min_depth', 'max_depth', 'fps', 'model', 'shape'.","default":false},"colormap":{"title":"Colormap","enum":["grayscale","turbo","inferno","magma","viridis"],"type":"string","description":"Colormap for depth visualization. 'turbo' (recommended) shows near=warm, far=cool. 'grayscale' for raw normalized depth. 'inferno'/'magma' for perceptually uniform. 'viridis' for colorblind-friendly.","default":"grayscale"},"max_frames":{"title":"Max Frames","description":"Max frames to process (max 2400). None = up to 2400.","anyOf":[{"exclusiveMinimum":0,"type":"integer"},{"type":"null"}]},"side_by_side":{"title":"Side By Side","type":"boolean","description":"Output original | depth comparison video.","default":false},"video_url":{"title":"Video Url","type":"string","examples":["https://v3b.fal.media/files/b/0a8fb1c1/xNTrr7wtczzLBkJdyE5_f_7JTYCmQe.mp4"],"description":"URL of the input video to estimate depth for."},"output_fps":{"title":"Output Fps","description":"Output video FPS. None = same as input.","anyOf":[{"exclusiveMinimum":0,"type":"number"},{"type":"null"}]},"model":{"enum":["VDA-Small","VDA-Base","VDA-Large"],"type":"string","title":"Model","description":"Depth estimation model size. VDA-Large = best quality, VDA-Small = fastest.","default":"VDA-Large"},"resolution":{"title":"Resolution","enum":["auto","360p","480p","720p","1080p"],"type":"string","description":"Output resolution. 'auto' preserves input (max 1080p). Options: 'auto', '360p', '480p', '720p', '1080p'.","default":"auto"}},"x-fal-order-properties":["video_url","model","colormap","resolution","max_frames","output_fps","side_by_side","include_raw_depths"],"description":"Input schema for video depth estimation.","required":["video_url"]},"DepthAnythingVideoOutput":{"title":"DepthAnythingVideoOutput","type":"object","properties":{"raw_depths":{"description":"Raw depth values as .npz (if include_raw_depths=True).","anyOf":[{"$ref":"#/components/schemas/File"},{"type":"null"}]},"video":{"$ref":"#/components/schemas/File","examples":[{"url":"https://v3b.fal.media/files/b/0a909a72/bC4JmEhmaBIaMC4vRhhTq_depth_output.mp4"}],"description":"Depth visualization video (MP4, H.264)."}},"x-fal-order-properties":["video","raw_depths"],"description":"Output schema for video depth estimation.","required":["video"]},"File":{"title":"File","type":"object","properties":{"url":{"title":"Url","type":"string","d