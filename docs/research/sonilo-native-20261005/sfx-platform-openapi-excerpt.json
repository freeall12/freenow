{
  "source": "https://platform.sonilo.com/openapi.json",
  "retrieved": "2026-10-05",
  "servers": [
    {
      "url": "https://api.sonilo.com",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/text-to-sfx": {
      "post": {
        "summary": "Generate a sound effect from text",
        "description": "Returns 202 with a task_id. Poll GET /v1/tasks/{task_id}. Generated audio carries an inaudible provenance watermark.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TextToSfxRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Async task created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskAccepted"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/video-to-sfx": {
      "post": {
        "summary": "Generate synchronized sound effects for a video",
        "description": "Accepts exactly one of video or video_url. Returns 202 with a task_id. Poll GET /v1/tasks/{task_id}. Generated audio carries an inaudible provenance watermark.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/VideoToSfxRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Async task created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskAccepted"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/tasks/{task_id}": {
      "get": {
        "summary": "Retrieve async task status",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status and result URLs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatus"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "Poll asynchronous Sonilo tasks using the exact path GET /v1/tasks/{task_id}. Do not guess /v1/task_id, /tasks/{task_id} without /v1, or /v1/tasks/{id}/status. Stop on succeeded/completed/failed/canceled and download media only after success."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "TextToSfxRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 180,
            "default": 8
          },
          "audio_format": {
            "type": "string"
          }
        }
      },
      "VideoToSfxRequest": {
        "type": "object",
        "properties": {
          "video": {
            "type": "string",
            "format": "binary",
            "description": "Max file size: default 300MB. Max duration: 480 sec."
          },
          "video_url": {
            "type": "string",
            "description": "Max file size: default 300MB. Max duration: 480 sec."
          },
          "prompt": {
            "type": "string"
          },
          "segments": {
            "type": "string"
          },
          "audio_format": {
            "type": "string"
          }
        }
      },
      "TaskAccepted": {
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing"
            ]
          }
        }
      },
      "TaskStatus": {
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "succeeded",
              "failed"
            ]
          },
          "audio": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaResult"
            }
          },
          "stems": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "One stream's four separated stems. The `vocals` here is a separated part of the GENERATED music; it is not the same thing as the `vocals` a `preserve_speech` request returns, which is speech isolated from the source video.",
              "properties": {
                "stream_index": {
                  "type": "integer"
                },
                "drums": {
                  "$ref": "#/components/schemas/MediaResult"
                },
                "bass": {
                  "$ref": "#/components/schemas/MediaResult"
                },
                "vocals": {
                  "$ref": "#/components/schemas/MediaResult"
                },
                "other": {
                  "$ref": "#/components/schemas/MediaResult"
                }
              },
              "required": [
                "stream_index",
                "drums",
                "bass",
                "vocals",
                "other"
              ]
            },
            "description": "Present only when the request set `stems=true`: one entry per stream that separated successfully. Look entries up by `stream_index` rather than by position — a stream whose separation failed is absent, so this array can be shorter than `audio`."
          },
          "stems_error": {
            "type": "string",
            "description": "Present when stem separation failed, wholly or in part, or was skipped. The task still succeeded and `audio` is unaffected — this names how many streams failed to separate and which, or reports that separation was skipped entirely. It can arrive alongside a shorter `stems` array rather than instead of one."
          },
          "video": {
            "$ref": "#/components/schemas/MediaResult"
          },
          "videos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaResult"
            },
            "description": "video-to-video-music / video-to-video-sfx: the scored video, one entry per variant. `video` is an alias for the first entry."
          },
          "outputs": {
            "description": "Two different shapes, never at once. Dubbing: an object mapping language code to dubbed video URL. video-to-sound / video-to-video-sound: an array with one entry per variant, each carrying `variant_index`, `output_url`, `output_type`, `output_bytes`, `music` and `sfx`, plus `music_processed` when a voice source was in play; the top-level `output_url`, `music` and `sfx` are aliases for the first entry.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "subtitles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Dubbing with export_srt only: an object mapping language code to a temporary download URL for that language's re-timed .srt."
          },
          "subtitle_preflight": {
            "type": "object",
            "description": "Dubbing with subtitle scripts only: per language, the validation report — status, cue_count, issues, changes_count and report_url."
          },
          "trial_preview": {
            "type": "object",
            "description": "Dubbing only, when the run was the account's free 15-second preview: preview_seconds, source_duration_seconds, trimmed, languages, full_video_cost_usd (what translating the full video costs) and message. Present in every task state.",
            "properties": {
              "preview_seconds": {
                "type": "integer"
              },
              "source_duration_seconds": {
                "type": "number"
              },
              "trimmed": {
                "type": "boolean"
              },
              "languages": {
                "type": "integer"
              },
              "full_video_cost_usd": {
                "type": "number"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "subtitle_export": {
            "type": "object",
            "description": "Dubbing with export_srt only: per language, an object with status (exported, exported_review_required or blocked), issues, alignment_loss, error and report_url; a blocked export never fails the task."
          },
          "output_url": {
            "type": "string",
            "description": "video-to-sound and video-to-video-sound only: URL of the combined output."
          },
          "output_type": {
            "type": "string",
            "enum": [
              "audio",
              "video"
            ],
            "description": "video-to-sound and video-to-video-sound only."
          },
          "output_bytes": {
            "type": "integer",
            "description": "video-to-sound and video-to-video-sound only: size in bytes of the file at output_url."
          },
          "music": {
            "$ref": "#/components/schemas/MediaResult"
          },
          "sfx": {
            "$ref": "#/components/schemas/MediaResult"
          },
          "music_processed": {
            "$ref": "#/components/schemas/MediaResult"
          },
          "mode": {
            "type": "string",
            "enum": [
              "both",
              "music",
              "sfx"
            ],
            "description": "video-analysis only: which brief the result carries, echoed from the request. both adds sfx_segments and sfx_prompt to segments and variations."
          },
          "segments": {
            "type": "array",
            "description": "video-analysis only.",
            "items": {
              "$ref": "#/components/schemas/VideoAnalysisSegment"
            }
          },
          "variations": {
            "type": "array",
            "description": "video-analysis only.",
            "items": {
              "$ref": "#/components/schemas/VideoAnalysisVariation"
            }
          },
          "sfx_segments": {
            "type": "array",
            "description": "video-analysis, mode both only: the sound-design segment plan, one shot-sized entry per segment; label is always none.",
            "items": {
              "$ref": "#/components/schemas/VideoAnalysisSegment"
            }
          },
          "sfx_prompt": {
            "type": "string",
            "description": "video-analysis, mode both only: the whole-clip sound-design prompt. Authored once regardless of variants_num."
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "MediaResult": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "file_size": {
            "type": "integer"
          },
          "stream_index": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "description": "Optional structured context; for a rejected dubbing subtitle script, the validation report."
          }
        }
      }
    }
  }
}
