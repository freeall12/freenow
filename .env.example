# Example only. The server reads process.env; this file is not auto-loaded.
# Start using your shell environment or Node's --env-file flag with a private file.
PORT=4173

# Agent and transcription use Responses / audio.transcriptions respectively.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional. Defaults to OPENAI_MODEL; must support Responses web_search.
# A compatible base URL/key alone does not establish native search support.
OPENAI_WEB_SEARCH_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
AGENT_MODEL_MAP={}
AGENT_REASONING_MAP={}

# tasks-v1: a gateway implementing POST/GET/DELETE /tasks. Key alone is insufficient.
# openai-native: Responses, Images generations / opted-in edits, and mapped Text-to-Speech.
# Image references opt in with supportsImageReferences:true and maxImages:1..16.
# See docs/OPENAI-IMAGE-REFERENCES.md; no real key or accessible model is supplied.
GENERATION_API_PROTOCOL=tasks-v1
GENERATION_API_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL_MAP={}

# Native mapping example. Replace model placeholders with accessible provider IDs.
# GENERATION_API_PROTOCOL=openai-native
# GENERATION_MODEL_MAP={"gpt-5.6-sol":{"kind":"text.generate","model":"YOUR_TEXT_MODEL","reasoningMap":{"low":"low","medium":"medium","high":"high"},"maxCount":1},"gpt-image-2":{"kind":"image.generate","model":"YOUR_IMAGE_MODEL","sizeMap":{"1:1|1K":"1024x1024"},"qualityMap":{"low":"low","medium":"medium","high":"high"},"maxCount":1}}

# Optional native speech entry (merge into GENERATION_MODEL_MAP; replace model ID):
# "doubao-seed-audio-1-0":{"kind":"audio.generate","scene":"Text-to-Speech","model":"YOUR_SPEECH_MODEL","defaultVoice":"alloy","formatMap":{"wav":"wav"},"defaultFormat":"wav","speedMap":{"0":1},"wavSampleRate":24000,"maxCount":1}
# Voice is an explicit operator selection. Only neutral pitch/loudness, no subtitles.
# See docs/OPENAI-SPEECH.md for supported options and output validation.

# Native focus recognition (merge into GENERATION_MODEL_MAP):
# "image.recognize":{"kind":"image.recognize","model":"YOUR_VISION_MODEL","detail":"high","maxOutputTokens":3000}
# Requires Responses vision + structured JSON output.

# Native scene breakdown: FFmpeg full-range detection/cuts plus per-scene vision.
# "video.analyze":{"kind":"video.analyze","model":"YOUR_VISION_MODEL","detail":"high","maxOutputTokens":1500}
# See docs/OPENAI-VIDEO-ANALYSIS.md. FFmpeg and FFprobe must be installed.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
